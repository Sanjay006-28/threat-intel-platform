# Virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environment variables (keep .env.example)
.env

# SQLite Databases, backups & temporary lock files
*.db
*.db-shm
*.db-wal
*.backup
*.bak
sentinel_backup_*
test_*.db*
