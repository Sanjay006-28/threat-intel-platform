# Ingested logs and uploaded files
auto_ingest/*.log
auto_ingest/*.processed
auto_ingest/*.txt
auto_ingest/*.json
!auto_ingest/.gitkeep
uploads/*
!uploads/.gitkeep

# Transient benchmarks and temporary logs
temp_*.log
*.log.temp
*.tmp
test_*.log

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
