# Virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environment variables (keep .env.example)
.env
*.key
.webhook_encryption.key

# SQLite Databases, backups & temporary lock files
*.db
*.db-shm
*.db-wal
*.backup
*.bak
backups/
sentinel_backup_*
test_*.db*
test_*.db-shm
test_*.db-wal

# Test suites and test artifacts
tests/
test_*.py
verify_*.py
pytest.ini

# Ingested logs and uploaded files
auto_ingest/*.log
auto_ingest/*.processed
auto_ingest/*.txt
auto_ingest/*.json
!auto_ingest/.gitkeep
uploads/*
!uploads/.gitkeep

# Transient benchmarks and temporary logs
temp_*.log
*.log.temp
*.tmp
test_*.log

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Screenshots and media artifacts
*.png
*.jpg
*.jpeg
*.gif
docs/screenshots/
!figures/
!figures/*.png

